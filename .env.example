# 会话加密密钥，生产环境请填写至少 32 位随机字符串
NUXT_SESSION_PASSWORD=

# SQLite/libSQL 数据库地址，默认使用本地 data/app.db
DATABASE_URL=file:./data/app.db

# 签名下载链接有效期，单位秒
DOWNLOAD_URL_EXPIRES_SECONDS=600

# Electron 应用公开更新检查接口是否要求 token
UPDATE_TOKEN_REQUIRED=false

# 普通文件公开更新/下载接口是否要求 token
FILE_UPDATE_TOKEN_REQUIRED=false

# CI/CD API 明文 token，适合本地开发
CI_API_TOKEN=

# CI/CD API token 的 SHA-256 hex 摘要，生产环境推荐使用这个
CI_API_TOKEN_SHA256=

# 分享页下载缓存开关，默认开启；缓存以文件 sha256 为键，命中后不再回源对象存储
DOWNLOAD_CACHE_ENABLED=true

# 下载缓存目录，Docker 部署建议放在挂载卷内，例如 /app/data/download-cache
DOWNLOAD_CACHE_DIR=./data/download-cache

# 单个文件允许缓存的最大字节数，默认 512MB；超过则直接透传不缓存
DOWNLOAD_CACHE_MAX_FILE_BYTES=536870912

# 缓存目录总大小上限，单位字节，默认 2GB，超出后按最近使用时间淘汰
DOWNLOAD_CACHE_MAX_BYTES=2147483648
